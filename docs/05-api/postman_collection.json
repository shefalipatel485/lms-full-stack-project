{
  "info": {
    "name": "EduSphere LMS API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/health"
      }
    },
    {
      "name": "Login (Admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"admin@lms.edu\", \"password\": \"Admin@123\"}"
        },
        "url": "{{base_url}}/api/auth/login"
      }
    },
    {
      "name": "Get Dashboard KPIs",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{base_url}}/api/reports/dashboard"
      }
    },
    {
      "name": "List Courses",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{base_url}}/api/courses"
      }
    },
    {
      "name": "Verify Certificate",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/certificates/verify/CERT-LMS-2026-8841"
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": ""
    }
  ]
}